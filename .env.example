# このファイルを .env にコピーして使ってください。
# .env は .gitignore 対象なので、実際の値は各環境ごとに管理されます。

# 実機クライアントに案内するサーバーのLAN上のIPアドレス
LFM_PUBLIC_HOST=192.168.1.x

# 内蔵DNSサーバー(既定: LFM_PUBLIC_HOST:53)。off で無効化
#LFM_DNS_ADDR=off

# MSN関連以外の名前の転送先。未設定なら即座にNXDOMAINを返す
#LFM_DNS_UPSTREAM=8.8.8.8:53

# LFMへ向けるドメインの追加(カンマ区切り)。例: msn.com
#LFM_DNS_EXTRA_ZONES=msn.com

# クライアント設定などを配信するWebサーバー(既定 :80)。off で無効化
#LFM_WEB_ADDR=off
